// src/app.rs
use std::num::NonZeroU32;
use std::sync::Arc;
use std::time::Instant;

use rodio::Player;
use winit::{
    application::ApplicationHandler,
    dpi::PhysicalSize,
    event::{ElementState, KeyEvent, WindowEvent},
    event_loop::ActiveEventLoop,
    keyboard::{
        KeyCode::{self, ScrollLock},
        PhysicalKey,
    },
    window::Window,
};

use crate::audio;
use crate::nav::{Level, NavState};
use crate::ui::{NowPlaying, UiEngine, UiFrame};

pub const WIDTH: u32 = 320;
pub const HEIGHT: u32 = 240;
pub const SCROLL_START_TIME: f32 = 1.0;
pub const SCROLL_SPEED: f32 = 30.0;
pub const MIN_LOOP_DISTANCE: f32 = 20.0;

#[derive(Debug, Clone, Copy)]
pub enum UserEvent {
    Tick,
}

struct NowPlayingState {
    title: String,
    artist: String,
    duration: f32,
    queue: Vec<PathBuf>,
    queue_index: usize,
    has_ended: bool,
}

pub struct App {
    window: Option<Arc<Window>>,
    surface: Option<softbuffer::Surface<Arc<Window>, Arc<Window>>>,
    ui: UiEngine,
    player: Player,
    _audio_handle: rodio::MixerDeviceSink,
    now_playing: Option<NowPlayingState>,
    battery: f32,
    bluetooth: bool,
    headphones: bool,
    nav: NavState,
    hover_start_time: Instant,
    now_playing_start_time: Instant,
    pub pingpong_scroll: bool,
}

impl App {
    pub fn new(
        ui: UiEngine,
        nav: NavState,
        player: Player,
        audio_handle: rodio::MixerDeviceSink,
    ) -> Self {
        Self {
            window: None,
            surface: None,
            ui,
            player,
            _audio_handle: audio_handle,
            now_playing: None,
            battery: 1.0,
            bluetooth: false,
            headphones: false,
            nav,
            hover_start_time: Instant::now(),
            now_playing_start_time: Instant::now(),
            pingpong_scroll: true,
        }
    }
}

fn clock_string() -> String {
    use std::time::{SystemTime, UNIX_EPOCH};
    let secs = SystemTime::now()
        .duration_since(UNIX_EPOCH)
        .map(|d| d.as_secs())
        .unwrap_or(0);
    format!("{:02}:{:02}", (secs / 3600) % 24, (secs / 60) % 60)
}

fn play_track_from_queue(&mut self, path: PathBuf, queue: Vec<PathBuf>, index: usize) {
    match audio::play_track(&self.player, &path) {
        Ok(info) => {
            println!("Playing: {}", info.title);
            self.now_playing_start_time = Instant::now();
            self.now_playing = Some(NowPlayingState {
                title: info.title,
                artist: info.artist,
                duration: info.duration,
                queue,
                queue_index: index,
                has_ended: false,
            });
            self.window.as_ref().unwrap().request_redraw();
        }
        Err(e) => {
            eprintln!("Error playing track: {}", e);
            // If a song fails to play, mark it as ended so we skip to the next one
            if let Some(np) = &mut self.now_playing {
                np.has_ended = true;
            }
        }
    }
}

impl ApplicationHandler<UserEvent> for App {
    fn resumed(&mut self, event_loop: &ActiveEventLoop) {
        let window = Arc::new(
            event_loop
                .create_window(
                    Window::default_attributes()
                        .with_title("MyMuse UI")
                        .with_inner_size(PhysicalSize::new(WIDTH, HEIGHT))
                        .with_resizable(false),
                )
                .unwrap(),
        );

        let context = softbuffer::Context::new(window.clone()).unwrap();
        let surface = softbuffer::Surface::new(&context, window.clone()).unwrap();

        self.window = Some(window);
        self.surface = Some(surface);
        self.window.as_ref().unwrap().request_redraw();
    }

    fn window_event(
        &mut self,
        event_loop: &ActiveEventLoop,
        _window_id: winit::window::WindowId,
        event: WindowEvent,
    ) {
        match event {
            WindowEvent::CloseRequested => event_loop.exit(),
            WindowEvent::KeyboardInput {
                event:
                    KeyEvent {
                        physical_key: PhysicalKey::Code(key_code),
                        state: ElementState::Pressed,
                        ..
                    },
                ..
            } => match key_code {
                KeyCode::Escape => event_loop.exit(),
                KeyCode::Backspace => {
                    if !self.nav.back() {
                        //Maybe use this to go into sleep mode or let it be a toggle in settings
                    } else {
                        self.hover_start_time = Instant::now();
                        self.window.as_ref().unwrap().request_redraw();
                    }
                }
                KeyCode::ArrowDown => {
                    let (_, idx, scroll) = self.nav.current();
                    let items_len = self.nav.get_items().len();

                    if *idx < items_len.saturating_sub(1) {
                        if let Some((_, idx_mut, scroll_mut)) = self.nav.level_stack.last_mut() {
                            *idx_mut += 1;
                            // If selection moves past the bottom of the viewport, scroll down
                            if *idx_mut >= *scroll_mut + self.ui.layout.visible_rows {
                                *scroll_mut += 1;
                            }
                        }
                        self.hover_start_time = Instant::now();
                        self.window.as_ref().unwrap().request_redraw();
                    }
                }
                KeyCode::ArrowUp => {
                    let (_, idx, scroll) = self.nav.current();

                    if *idx > 0 {
                        if let Some((_, idx_mut, scroll_mut)) = self.nav.level_stack.last_mut() {
                            *idx_mut -= 1;
                            // If selection moves above the top of the viewport, scroll up
                            if *idx_mut < *scroll_mut {
                                *scroll_mut -= 1;
                            }
                        }
                        self.hover_start_time = Instant::now();
                        self.window.as_ref().unwrap().request_redraw();
                    }
                }
                KeyCode::Enter => {
                    self.hover_start_time = Instant::now();

                    if let Some(track_path) = self.nav.enter() {
                        let queue = self.nav.get_current_playlist();
                        let queue_index = queue_iter().position(|p| p == &track_path).unwrap_or(0);
                        self.play_track_from_queue(track_path, queue, queue_index);
                    }
                    self.window.as_ref().unwrap.request_redraw();
                }
                _ => {}
            },
            WindowEvent::RedrawRequested => {
                if let (Some(window), Some(surface)) = (&self.window, &mut self.surface) {
                    let clock = clock_string();
                    let elapsed = self.player.get_pos().as_secs_f32();

                    // Fetch data from Navstate and generate title based on curr level
                    let items = self.nav.get_items();
                    let (_, selected_index, scroll_offset) = self.nav.current().clone();

                    // Marquee logic
                    let mut list_scroll = None;
                    let mut now_scroll = None;

                    // 1. List scrolling timer
                    let hover_secs = self.hover_start_time.elapsed().as_secs_f32();
                    if hover_secs > SCROLL_START_TIME {
                        let scroll_time = hover_secs - SCROLL_START_TIME;

                        let selected_text =
                            items.get(selected_index).map(|s| s.as_str()).unwrap_or("");
                        let text_w = self
                            .ui
                            .measure_text(selected_text, self.ui.layout.font_size_list);

                        if text_w > self.ui.layout.list_item_max_width {
                            let loop_dist = if self.pingpong_scroll {
                                text_w - self.ui.layout.list_item_max_width
                            } else {
                                text_w + self.ui.layout.list_scroll_gap
                            };

                            let pause_multiplier =
                                if self.pingpong_scroll && loop_dist < MIN_LOOP_DISTANCE {
                                    1.0 + (1.0 - (loop_dist / MIN_LOOP_DISTANCE)) * 2.0
                                } else {
                                    1.0
                                };
                            let dynamic_pause = SCROLL_START_TIME * pause_multiplier;

                            let offset = get_textloop_offset(
                                self.pingpong_scroll,
                                scroll_time,
                                loop_dist,
                                dynamic_pause,
                            );
                            list_scroll = Some((offset, text_w));
                        }
                    }
                    // 2. Now Playing Scrolling timer
                    let now_hover_secs = self.now_playing_start_time.elapsed().as_secs_f32();
                    if now_hover_secs > SCROLL_START_TIME {
                        let now_scroll_time = now_hover_secs - SCROLL_START_TIME;

                        if let Some(np) = &self.now_playing {
                            let title_w = self
                                .ui
                                .measure_text(&np.title, self.ui.layout.font_size_nowplay);

                            if title_w > self.ui.layout.nowplay_max_width {
                                let loop_dist = if self.pingpong_scroll {
                                    title_w - self.ui.layout.nowplay_max_width
                                } else {
                                    title_w + self.ui.layout.nowplay_scroll_gap
                                };

                                let pause_multiplier =
                                    if self.pingpong_scroll && loop_dist < MIN_LOOP_DISTANCE {
                                        1.0 + (1.0 - (loop_dist / MIN_LOOP_DISTANCE)) * 2.0
                                    } else {
                                        1.0
                                    };
                                let dynamic_pause = SCROLL_START_TIME * pause_multiplier;

                                let offset = get_textloop_offset(
                                    self.pingpong_scroll,
                                    now_scroll_time,
                                    loop_dist,
                                    dynamic_pause,
                                );
                                now_scroll = Some((offset, title_w));
                            }
                        }
                    }

                    // Now Playing Scrolling timer
                    let title = match &self.nav.current().0 {
                        Level::Root => "MyMuse".to_string(),
                        Level::Artists => "Artists".to_string(),
                        Level::AlbumsOf(a) => a.clone(),
                        Level::TracksOf(a, al) => {
                            format!("{} - {}", a, al)
                        }
                        Level::AllAlbums => "Albums".to_string(),
                        Level::AllSongs => "Songs".to_string(),
                    };

                    let frame = UiFrame {
                        items: &items,
                        selected_index,
                        scroll_offset,
                        title: &title,
                        clock: &clock,
                        battery: self.battery,
                        bluetooth: self.bluetooth,
                        headphones: self.headphones,
                        now: self.now_playing.as_ref().map(|np| NowPlaying {
                            title: &np.title,
                            artist: &np.artist,
                            elapsed,
                            duration: np.duration,
                        }),
                        list_scroll,
                        now_scroll,
                        is_reversing: self.pingpong_scroll,
                    };

                    let buffer = self.ui.draw(frame);

                    surface
                        .resize(
                            NonZeroU32::new(WIDTH).unwrap(),
                            NonZeroU32::new(HEIGHT).unwrap(),
                        )
                        .unwrap();

                    let mut surface_buffer = surface.buffer_mut().unwrap();
                    surface_buffer.copy_from_slice(buffer);
                    surface_buffer.present().unwrap();
                }
            }
            _ => {}
        }
    }

    fn user_event(&mut self, _event_loop: &ActiveEventLoop, event: UserEvent) {
        if let UserEvent::Tick = event {
            let mut next_track = None;

            // Check if the song ended
            if let Some(np) = &mut self.now_playing {
                if self.player.empty() && !np.has_ended {
                    np.has_ended = true;
                    let next_idx = np.queue_index + 1;

                    if next_idx < np.queue.len() {
                        // queue next track
                        next_track = Some((np.queue[next_idx].clone(), np.queue.clone(), next_idx));
                    }
                }
            }

            if let Some((path, queue, idx)) = next_track {
                self.play_track_from_queue(path, queue, idx);
            }

            if let Some(window) = &self.window {
                window.request_redraw();
            }
        }
    }
}

fn get_textloop_offset(
    pingpong_scroll: bool,
    scroll_time: f32,
    loop_dist: f32,
    pause_time: f32,
) -> f32 {
    if pingpong_scroll {
        let travel_time = loop_dist / SCROLL_SPEED;
        let cycle = (travel_time + pause_time) * 2.0;
        let t = scroll_time % cycle;

        if t < travel_time {
            // Moving right (scrolling text left)
            t * SCROLL_SPEED
        } else if t < travel_time + pause_time {
            // Pause at the end
            loop_dist
        } else if t < travel_time * 2.0 + pause_time {
            // Moving left (scrolling text right)
            loop_dist - ((t - travel_time - pause_time) * SCROLL_SPEED)
        } else {
            // Pause at the start (waiting for the next loop)
            0.0
        }
    } else {
        // Standard looping math
        (scroll_time * SCROLL_SPEED) % loop_dist
    }
}
